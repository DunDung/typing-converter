{
  "expo": {
    "name": "한영타변환기",
    "slug": "typing-converter",
    "version": "26.9.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.typingconverter",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.typing_converter",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/play-store.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "eas": {
        "projectId": "949b9326-50c0-4430-b64d-33eb99fae738"
      }
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1298150935322847~8783205082",
          "iosAppId": "ca-app-pub-1298150935322847~1368110885"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugins/withSceneLifecycle"
    ]
  }
}
